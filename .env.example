# Copy this file to `.env` at the project root and fill in your own values.
# `.env` is git-ignored - never commit real secrets, only this example file.

# Required for anything that fetches live news. Get a free key at
# https://newsapi.org (the key previously hardcoded in src/ was exposed -
# generate a fresh one).
NEWSAPI_KEY=

# Optional: Sieve scrape API (https://scrape.usesieve.com). Lets the app scrape
# public pages on request. Leave blank to keep the integration fully disabled -
# the rest of the app works exactly the same either way.
# Run `python src/sieve_login.py` to log in with a device code and have the key
# written here for you, or paste a key from Settings -> API keys.
# This key has full account access and must stay server-side only.
SIEVE_API_KEY=
# SIEVE_BASE_URL=https://scrape.usesieve.com

# Optional overrides (the defaults below are used when unset):
# OLLAMA_MODEL=llama3.2
# LOCAL_MODEL_PATH=models/finbert_finetuned/final_model
