# Copy this file to `.env` at the project root and fill in your own values.
# `.env` is git-ignored - never commit real secrets, only this example file.

# Required for anything that fetches live news. Get a free key at
# https://newsapi.org (the key previously hardcoded in src/ was exposed -
# generate a fresh one).
NEWSAPI_KEY=

# Optional overrides (the defaults below are used when unset):
# OLLAMA_MODEL=llama3.2
# LOCAL_MODEL_PATH=models/finbert_finetuned/final_model
